<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GroceryMate</title>
  <link rel="stylesheet" href="<%= basePath %>/styles.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

  <!-- App Header -->
  <header class="app-header">
    <div class="header-inner">
      <div class="header-brand">
        <i class="fas fa-shopping-bag"></i>
        <span>GroceryMate</span>
      </div>
      <div class="header-right">
        <span class="header-user"><i class="fas fa-user-circle"></i> <span id="username"></span></span>
        <span id="role" style="display:none"></span>
        <button id="logout" class="btn-icon" title="Logout"><i class="fas fa-sign-out-alt"></i></button>
      </div>
    </div>
    <!-- Desktop navigation (hidden on mobile) -->
    <div class="desktop-nav">
      <div class="desktop-nav-inner">
        <a href="#" id="dashboardLink" class="nav-link active"><i class="fas fa-home"></i> Dashboard</a>
        <a href="#" id="reportsLink" class="nav-link" style="display:none"><i class="fas fa-chart-bar"></i> Reports</a>
        <a href="#" id="usersLink" class="nav-link" style="display:none"><i class="fas fa-users"></i> Users</a>
        <a href="#" id="configLink" class="nav-link" style="display:none"><i class="fas fa-cog"></i> Config</a>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="app-main">

    <!-- Dashboard View -->
    <div id="dashboardView" class="view">
      <div class="balance-hero">
        <div class="balance-hero-inner">
          <div class="balance-label"><i class="fas fa-wallet"></i> Current Balance</div>
          <div class="balance-amount" id="currentBalanceValue">$0.00</div>
          <div class="balance-meta" id="currentBalanceMeta">No transactions yet</div>
        </div>
      </div>
      <div class="content-section">
        <div class="section-header">
          <h2>Transactions</h2>
          <button class="btn-add" id="addTxnBtn"><i class="fas fa-plus"></i> Add</button>
        </div>
        <div id="transactionsCards" class="transactions-cards"></div>
        <div class="table-container">
          <table id="transactionsTable">
            <thead>
              <tr>
                <th><i class="fas fa-clock"></i> Date/Time</th>
                <th><i class="fas fa-money-bill-wave"></i> Amount</th>
                <th><i class="fas fa-tag"></i> Type</th>
                <th><i class="fas fa-wallet"></i> Balance</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
        <div id="transactionsPagination" class="pagination-controls"></div>
      </div>
    </div>

    <!-- Reports View -->
    <div id="reportsView" class="view" style="display:none">
      <div class="content-section">
        <div class="section-header"><h2>Reports</h2></div>
        <div class="card" id="reportsContent"><p>Loading reports...</p></div>
      </div>
    </div>

    <!-- Users View -->
    <div id="usersView" class="view" style="display:none">
      <div class="content-section">
        <div class="section-header"><h2>Add User</h2></div>
        <div class="card">
          <form id="userForm">
            <div class="form-row">
              <div class="input-group input-with-icon">
                <i class="fas fa-user"></i>
                <label for="newUsername">Username</label>
                <input type="text" id="newUsername" placeholder="Username" required>
              </div>
              <div class="input-group input-with-icon">
                <i class="fas fa-lock"></i>
                <label for="newPassword">Password</label>
                <input type="password" id="newPassword" placeholder="Password" required>
              </div>
              <div class="input-group input-with-icon">
                <i class="fas fa-shield-alt"></i>
                <label for="newRole">Role</label>
                <select id="newRole" required>
                  <option value="admin">Admin</option>
                  <option value="helper">Helper</option>
                </select>
              </div>
            </div>
            <button type="submit" class="btn btn-primary"><i class="fas fa-plus"></i> Add User</button>
          </form>
        </div>
        <div class="section-header" style="margin-top:24px"><h2>All Users</h2></div>
        <div class="card">
          <div id="usersContent"><p>Loading users...</p></div>
        </div>
      </div>
    </div>

    <!-- Config View -->
    <div id="configView" class="view" style="display:none">
      <div class="content-section">
        <div class="section-header"><h2>Add Type</h2></div>
        <div class="card">
          <form id="typeForm">
            <div class="form-row">
              <div class="input-group input-with-icon">
                <i class="fas fa-tag"></i>
                <label for="typeName">Type Name</label>
                <input type="text" id="typeName" placeholder="e.g., dairy" required>
              </div>
              <div class="input-group input-with-icon">
                <i class="fas fa-layer-group"></i>
                <label for="typeCategory">Category</label>
                <select id="typeCategory" required>
                  <option value="credit">Credit</option>
                  <option value="expense">Expense</option>
                </select>
              </div>
            </div>
            <button type="submit" class="btn btn-primary"><i class="fas fa-plus"></i> Add Type</button>
          </form>
        </div>
        <div class="section-header" style="margin-top:24px"><h2>Transaction Types</h2></div>
        <div class="card">
          <div id="configContent"><p>Loading transaction types...</p></div>
        </div>
      </div>
    </div>

  </main>

  <!-- FAB (mobile only) -->
  <button class="fab" id="fabAdd" aria-label="Add transaction">
    <i class="fas fa-plus"></i>
  </button>

  <!-- Sheet backdrop -->
  <div class="sheet-backdrop" id="sheetBackdrop"></div>

  <!-- Add Transaction Sheet (bottom sheet on mobile, modal on desktop) -->
  <div class="bottom-sheet" id="addSheet">
    <div class="sheet-handle"></div>
    <h3 class="sheet-title"><i class="fas fa-plus-circle"></i> Add Transaction</h3>
    <form id="transactionForm">
      <div class="form-row">
        <div class="input-group input-with-icon">
          <i class="fas fa-calendar-alt"></i>
          <label for="datetime">Date & Time</label>
          <input type="datetime-local" id="datetime" required>
        </div>
        <div class="input-group input-with-icon">
          <i class="fas fa-dollar-sign"></i>
          <label for="amount">Amount</label>
          <input type="number" step="0.01" id="amount" placeholder="0.00" required inputmode="decimal">
        </div>
      </div>
      <div class="form-row">
        <div class="input-group input-with-icon" id="typeGroup">
          <i class="fas fa-list"></i>
          <label for="type">Type</label>
          <select id="type"><option value="cash">Cash</option></select>
        </div>
      </div>
      <div class="input-group input-with-icon">
        <i class="fas fa-sticky-note"></i>
        <label for="notes">Notes</label>
        <textarea id="notes" placeholder="Add any additional notes"></textarea>
      </div>
      <div class="input-group input-with-icon">
        <i class="fas fa-camera"></i>
        <label for="receipt">Receipt Photo (optional)</label>
        <input type="file" id="receipt" accept="image/*" capture="environment">
      </div>
      <div class="sheet-actions">
        <button type="button" class="btn btn-secondary" id="cancelSheet">Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save</button>
      </div>
    </form>
  </div>

  <!-- Bottom Navigation (mobile only) -->
  <nav class="bottom-nav">
    <a href="#" class="bottom-nav-item active" id="dashboardNavItem" data-view="dashboard">
      <i class="fas fa-home"></i>
      <span>Home</span>
    </a>
    <a href="#" class="bottom-nav-item" id="reportsNavItem" data-view="reports" style="display:none">
      <i class="fas fa-chart-bar"></i>
      <span>Reports</span>
    </a>
    <a href="#" class="bottom-nav-item" id="usersNavItem" data-view="users" style="display:none">
      <i class="fas fa-users"></i>
      <span>Users</span>
    </a>
    <a href="#" class="bottom-nav-item" id="configNavItem" data-view="config" style="display:none">
      <i class="fas fa-cog"></i>
      <span>Config</span>
    </a>
  </nav>

  <!-- Upload overlay -->
  <div id="upload-overlay">
    <div class="upload-spinner"></div>
    <div class="upload-overlay-text">Uploading receipt…</div>
  </div>

  <script>window.APP_BASE_PATH = '<%= basePath %>';</script>
  <script src="<%= basePath %>/script.js"></script>
</body>
</html>
