# Database credentials
DB_USER=postgres
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string

# Host paths (data persists here across Portainer redeployments)
DB_DATA_PATH=/opt/grocerymate/db
BACKUP_PATH=/opt/grocerymate/backups

# WhatsApp notifications via WA-Gateway (leave blank to disable)
WA_GATEWAY_URL=http://192.168.x.x:PORT
WA_GATEWAY_TOKEN=your-wa-gateway-token
WA_GROUP_JID=123456789@g.us
# URL this app is reachable at FROM the WA-Gateway (for receipt image attachment)
APP_INTERNAL_URL=http://192.168.x.x:2000
